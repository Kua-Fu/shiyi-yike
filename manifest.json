{
  "manifest_version": 3,
  "name": "诗意一刻",
  "version": "1.14.0",
  "description": "点击工具栏图标，逐句精读、主动回想并按期复习精选古典诗词，不替换浏览器的新标签页。",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "打开诗意一刻",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  },
  "permissions": [
    "storage"
  ]
}
