{
  "manifest_version": 3,
  "name": "诗意一刻｜古诗词精读与记忆",
  "short_name": "诗意一刻",
  "version": "1.16.0",
  "description": "逐句读懂古诗词，理解篇章转折，再用主动回想与间隔复习真正记住；无需账号，不替换新标签页。",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "打开诗意一刻",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  },
  "permissions": [
    "storage"
  ]
}
